[Unit]
Description=EGX-Genom API (Fastify) -- live Decision Center / Capital Allocation backend
Documentation=file:///opt/egx-genom/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/egx-genom/api
# uv must be resolvable: decisions.ts shells out to `uv run --project
# <researchDir> python -m agx_research.cli ...` for /decisions and
# /capital-allocation (see api/src/routes/decisions.ts). Adjust if uv was
# installed somewhere else on this host (`command -v uv`).
Environment="PATH=/root/.local/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PORT=3001"
Environment="KNOWLEDGE_STORE_PATH=/opt/egx-genom/research/data/knowledge.json"
Environment="EVENTS_STORE_PATH=/opt/egx-genom/research/data/events.json"
Environment="RUNS_STORE_PATH=/opt/egx-genom/research/data/runs.json"
# Must match egx-collector.service's --dashboard-out exactly -- the API
# serves whatever the collector last wrote there, nothing else.
Environment="DASHBOARD_ARTIFACTS_DIR=/opt/egx-genom/web/public/data"
# Same --data-dir egx-collector.service's `agx run` uses -- Decision Center
# and Capital Allocation must compute against the data the rest of the
# dashboard is already showing, never a second/guessed directory.
Environment="DECISION_DATA_DIR=/opt/egx-genom/research/data"
Environment="UNIVERSE_SEED_DIR=/opt/egx-genom/research/data/universe"
# Resolved via PATH (set above) rather than a hardcoded /usr/bin/node,
# since Node's install location varies (apt, NodeSource, nvm system-wide).
ExecStart=/usr/bin/env node /opt/egx-genom/api/dist/index.js
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=egx-api
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/egx-genom/research/data
# This box hosts other independent services -- an unbounded Node process
# must never be able to starve them. 768M/512M is a generous starting
# ceiling for a Fastify service that only reads modest per-route JSON
# artifacts (see api/src/artifactsStore.ts, api/src/knowledgeStore.ts);
# it has not been load-tested, so treat it as a safety net against a
# runaway request pattern, not a precisely measured floor -- tighten it
# once real production RSS under load is known. MemoryHigh throttles
# (cgroup memory pressure/reclaim) before MemoryMax's hard OOM-kill, so a
# brief spike degrades gracefully instead of killing the service outright.
MemoryHigh=512M
MemoryMax=768M

[Install]
WantedBy=multi-user.target
