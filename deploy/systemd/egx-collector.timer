[Unit]
Description=EGX-Genom Collector Every-Minute Timer
Requires=egx-collector.service

[Timer]
# Refresh free market, macro, fundamentals, and news artifacts every minute.
# The service writes to /opt/egx-genom/web/public/data for the dashboard.
OnUnitActiveSec=60s
AccuracySec=1s
Unit=egx-collector.service
Persistent=true

[Install]
WantedBy=timers.target
