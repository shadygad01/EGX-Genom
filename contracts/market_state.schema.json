{
  "$defs": {
    "CorporateEvent": {
      "description": "A corporate action or disclosure (earnings, dividend, capital change, etc.).",
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "event_date": {
          "format": "date",
          "title": "Event Date",
          "type": "string"
        },
        "event_type": {
          "title": "Event Type",
          "type": "string"
        },
        "ticker": {
          "title": "Ticker",
          "type": "string"
        }
      },
      "required": [
        "ticker",
        "event_date",
        "event_type",
        "description"
      ],
      "title": "CorporateEvent",
      "type": "object"
    },
    "DatasetSnapshot": {
      "description": "`version` is always 1: `id` is a content hash, so genuinely different\ncontent always gets a different id rather than a new revision of the\nsame one. The field exists so `DatasetSnapshotRepository` (and the\ngeneric `storage.Repository[T]` it's built on) can treat every entity\nin the system uniformly, per \"everything must be versioned.\"",
      "properties": {
        "as_of": {
          "format": "date",
          "title": "As Of",
          "type": "string"
        },
        "corporate_events": {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/CorporateEvent"
            },
            "type": "array"
          },
          "title": "Corporate Events",
          "type": "object"
        },
        "financial_statements": {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/FinancialStatementLineItem"
            },
            "type": "array"
          },
          "title": "Financial Statements",
          "type": "object"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "long_corporate_events": {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/CorporateEvent"
            },
            "type": "array"
          },
          "title": "Long Corporate Events",
          "type": "object"
        },
        "long_price_history": {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/PriceBar"
            },
            "type": "array"
          },
          "title": "Long Price History",
          "type": "object"
        },
        "lookback_days": {
          "title": "Lookback Days",
          "type": "integer"
        },
        "macro_lookback_days": {
          "title": "Macro Lookback Days",
          "type": "integer"
        },
        "macro_series": {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/MacroObservation"
            },
            "type": "array"
          },
          "title": "Macro Series",
          "type": "object"
        },
        "macro_series_ids": {
          "items": {
            "type": "string"
          },
          "title": "Macro Series Ids",
          "type": "array"
        },
        "news": {
          "items": {
            "$ref": "#/$defs/NewsItem"
          },
          "title": "News",
          "type": "array"
        },
        "pattern_lookback_days": {
          "default": 0,
          "title": "Pattern Lookback Days",
          "type": "integer"
        },
        "price_history": {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/PriceBar"
            },
            "type": "array"
          },
          "title": "Price History",
          "type": "object"
        },
        "tickers": {
          "items": {
            "type": "string"
          },
          "title": "Tickers",
          "type": "array"
        },
        "version": {
          "default": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "as_of",
        "lookback_days",
        "macro_lookback_days",
        "tickers",
        "macro_series_ids"
      ],
      "title": "DatasetSnapshot",
      "type": "object"
    },
    "EntityKind": {
      "enum": [
        "company",
        "sector",
        "macro_series",
        "market",
        "unknown"
      ],
      "title": "EntityKind",
      "type": "string"
    },
    "EntityRef": {
      "properties": {
        "canonical_id": {
          "title": "Canonical Id",
          "type": "string"
        },
        "display_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "kind": {
          "$ref": "#/$defs/EntityKind"
        },
        "raw_mention": {
          "title": "Raw Mention",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "canonical_id",
        "raw_mention"
      ],
      "title": "EntityRef",
      "type": "object"
    },
    "Event": {
      "properties": {
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "disputed_keys": {
          "items": {
            "type": "string"
          },
          "title": "Disputed Keys",
          "type": "array"
        },
        "entities": {
          "items": {
            "$ref": "#/$defs/EntityRef"
          },
          "title": "Entities",
          "type": "array"
        },
        "event_date": {
          "format": "date",
          "title": "Event Date",
          "type": "string"
        },
        "event_type": {
          "$ref": "#/$defs/EventType"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "impact_horizons": {
          "items": {
            "$ref": "#/$defs/Horizon"
          },
          "title": "Impact Horizons",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "relationships": {
          "items": {
            "$ref": "#/$defs/EventRelationship"
          },
          "title": "Relationships",
          "type": "array"
        },
        "severity": {
          "$ref": "#/$defs/EventSeverity"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "sources": {
          "items": {
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/EventStatus",
          "default": "pending"
        },
        "subtype": {
          "title": "Subtype",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "version": {
          "default": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "event_type",
        "subtype",
        "event_date",
        "timestamp",
        "source",
        "confidence",
        "severity",
        "provenance"
      ],
      "title": "Event",
      "type": "object"
    },
    "EventRelationship": {
      "properties": {
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        },
        "related_event_id": {
          "title": "Related Event Id",
          "type": "string"
        },
        "relationship_type": {
          "$ref": "#/$defs/EventRelationshipType"
        }
      },
      "required": [
        "related_event_id",
        "relationship_type"
      ],
      "title": "EventRelationship",
      "type": "object"
    },
    "EventRelationshipType": {
      "enum": [
        "corroborates",
        "supersedes",
        "contradicts",
        "causally_precedes",
        "part_of"
      ],
      "title": "EventRelationshipType",
      "type": "string"
    },
    "EventSeverity": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "EventSeverity",
      "type": "string"
    },
    "EventStatus": {
      "enum": [
        "pending",
        "confirmed",
        "corroborated",
        "disputed",
        "retracted",
        "superseded",
        "archived"
      ],
      "title": "EventStatus",
      "type": "string"
    },
    "EventType": {
      "enum": [
        "corporate",
        "macroeconomic",
        "political",
        "market",
        "technical",
        "news"
      ],
      "title": "EventType",
      "type": "string"
    },
    "FinancialStatementLineItem": {
      "properties": {
        "currency": {
          "default": "EGP",
          "title": "Currency",
          "type": "string"
        },
        "line_item": {
          "title": "Line Item",
          "type": "string"
        },
        "period_end_date": {
          "format": "date",
          "title": "Period End Date",
          "type": "string"
        },
        "period_type": {
          "title": "Period Type",
          "type": "string"
        },
        "statement_type": {
          "title": "Statement Type",
          "type": "string"
        },
        "ticker": {
          "title": "Ticker",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "ticker",
        "period_end_date",
        "period_type",
        "statement_type",
        "line_item",
        "value"
      ],
      "title": "FinancialStatementLineItem",
      "type": "object"
    },
    "Horizon": {
      "description": "The three independent time horizons the platform optimizes simultaneously.",
      "enum": [
        "micro",
        "swing",
        "investment"
      ],
      "title": "Horizon",
      "type": "string"
    },
    "MacroObservation": {
      "description": "A single macroeconomic series observation (e.g. EGP/USD, oil price, CBE rate).",
      "properties": {
        "observation_date": {
          "format": "date",
          "title": "Observation Date",
          "type": "string"
        },
        "series_id": {
          "title": "Series Id",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "series_id",
        "observation_date",
        "value"
      ],
      "title": "MacroObservation",
      "type": "object"
    },
    "NewsItem": {
      "description": "A news/sentiment item, optionally linked to one or more tickers.",
      "properties": {
        "body": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Body"
        },
        "headline": {
          "title": "Headline",
          "type": "string"
        },
        "published_at": {
          "format": "date",
          "title": "Published At",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "tickers": {
          "items": {
            "type": "string"
          },
          "title": "Tickers",
          "type": "array"
        }
      },
      "required": [
        "published_at",
        "source",
        "headline"
      ],
      "title": "NewsItem",
      "type": "object"
    },
    "PriceBar": {
      "description": "A single daily OHLCV observation for one ticker.",
      "properties": {
        "close": {
          "title": "Close",
          "type": "number"
        },
        "high": {
          "title": "High",
          "type": "number"
        },
        "low": {
          "title": "Low",
          "type": "number"
        },
        "open": {
          "title": "Open",
          "type": "number"
        },
        "ticker": {
          "title": "Ticker",
          "type": "string"
        },
        "trade_date": {
          "format": "date",
          "title": "Trade Date",
          "type": "string"
        },
        "volume": {
          "title": "Volume",
          "type": "integer"
        }
      },
      "required": [
        "ticker",
        "trade_date",
        "open",
        "high",
        "low",
        "close",
        "volume"
      ],
      "title": "PriceBar",
      "type": "object"
    },
    "Provenance": {
      "properties": {
        "inputs": {
          "items": {
            "$ref": "#/$defs/ProvenanceRef"
          },
          "title": "Inputs",
          "type": "array"
        },
        "produced_at": {
          "format": "date-time",
          "title": "Produced At",
          "type": "string"
        },
        "produced_by": {
          "title": "Produced By",
          "type": "string"
        }
      },
      "required": [
        "produced_by",
        "produced_at"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "ProvenanceRef": {
      "description": "A pointer to one input entity: what kind it is, its id, and (if versioned) which version.",
      "properties": {
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "ref_id": {
          "title": "Ref Id",
          "type": "string"
        },
        "ref_version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ref Version"
        }
      },
      "required": [
        "kind",
        "ref_id"
      ],
      "title": "ProvenanceRef",
      "type": "object"
    },
    "TradingSession": {
      "properties": {
        "holiday_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Holiday Name"
        },
        "is_trading_day": {
          "title": "Is Trading Day",
          "type": "boolean"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        },
        "session_date": {
          "format": "date",
          "title": "Session Date",
          "type": "string"
        }
      },
      "required": [
        "session_date",
        "is_trading_day"
      ],
      "title": "TradingSession",
      "type": "object"
    }
  },
  "properties": {
    "as_of": {
      "format": "date",
      "title": "As Of",
      "type": "string"
    },
    "constituents": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Constituents",
      "type": "object"
    },
    "dataset_snapshot": {
      "$ref": "#/$defs/DatasetSnapshot"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/Event"
      },
      "title": "Events",
      "type": "array"
    },
    "sectors": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Sectors",
      "type": "object"
    },
    "trading_session": {
      "$ref": "#/$defs/TradingSession"
    }
  },
  "required": [
    "as_of",
    "dataset_snapshot",
    "trading_session"
  ],
  "title": "MarketState",
  "type": "object"
}
