{
  "$defs": {
    "AccessMethod": {
      "enum": [
        "csv_download",
        "json_api",
        "rss_feed",
        "xbrl",
        "pdf_download",
        "html_scrape",
        "manual"
      ],
      "title": "AccessMethod",
      "type": "string"
    },
    "ActivationStatus": {
      "description": "Whether this source is switched on for scheduled collection.",
      "enum": [
        "active",
        "paused",
        "retired"
      ],
      "title": "ActivationStatus",
      "type": "string"
    },
    "HealthStatus": {
      "description": "Current operational health, maintained by `sources.health`.",
      "enum": [
        "unknown",
        "healthy",
        "degraded",
        "down"
      ],
      "title": "HealthStatus",
      "type": "string"
    },
    "LegalUseStatus": {
      "description": "Independent legal-review state; implementation is never legal clearance.",
      "enum": [
        "cleared",
        "research_only",
        "review_required",
        "blocked"
      ],
      "title": "LegalUseStatus",
      "type": "string"
    },
    "LifecycleState": {
      "description": "Where a source sits in the qualification pipeline (`sources.qualification`).\n\nDistinct from `SourceStatus`: `status` gates *whether a collector may run\nat all* (auth/ToS/config); `lifecycle_state` gates *how much the rest of\nthe platform trusts it* once it can run. A source can be IMPLEMENTED and\nstill only CANDIDATE/QUARANTINE if it hasn't accumulated evidence yet.\nPromotion only ever moves forward one stage at a time and only on\nevidence (see `qualification.evaluate_promotion`) \u2014 never assigned by\nfiat, never skipped.",
      "enum": [
        "candidate",
        "quarantine",
        "evaluation",
        "trusted",
        "core"
      ],
      "title": "LifecycleState",
      "type": "string"
    },
    "RateLimit": {
      "properties": {
        "min_seconds_between_requests": {
          "default": 1.0,
          "title": "Min Seconds Between Requests",
          "type": "number"
        },
        "requests_per_minute": {
          "default": 10,
          "title": "Requests Per Minute",
          "type": "integer"
        }
      },
      "title": "RateLimit",
      "type": "object"
    },
    "RetryPolicy": {
      "properties": {
        "backoff_multiplier": {
          "default": 2.0,
          "title": "Backoff Multiplier",
          "type": "number"
        },
        "backoff_seconds": {
          "default": 2.0,
          "title": "Backoff Seconds",
          "type": "number"
        },
        "max_attempts": {
          "default": 3,
          "title": "Max Attempts",
          "type": "integer"
        }
      },
      "title": "RetryPolicy",
      "type": "object"
    },
    "SourceCategory": {
      "enum": [
        "official",
        "company",
        "market_data",
        "news",
        "arabic_news",
        "macroeconomic",
        "global_markets",
        "alternative",
        "research"
      ],
      "title": "SourceCategory",
      "type": "string"
    },
    "SourceStatus": {
      "enum": [
        "implemented",
        "planned",
        "needs_key",
        "tos_review",
        "disabled"
      ],
      "title": "SourceStatus",
      "type": "string"
    }
  },
  "properties": {
    "access_method": {
      "$ref": "#/$defs/AccessMethod"
    },
    "activation_status": {
      "$ref": "#/$defs/ActivationStatus",
      "default": "active"
    },
    "authentication": {
      "default": "none",
      "title": "Authentication",
      "type": "string"
    },
    "base_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Base Url"
    },
    "category": {
      "$ref": "#/$defs/SourceCategory"
    },
    "collector": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Collector"
    },
    "collector_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Collector Version"
    },
    "conflict_priority": {
      "default": 50,
      "description": "Higher wins ties in cross-source conflict resolution (0-100).",
      "title": "Conflict Priority",
      "type": "integer"
    },
    "country": {
      "default": "EG",
      "title": "Country",
      "type": "string"
    },
    "data_quality_score": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Measured only; never declared.",
      "title": "Data Quality Score"
    },
    "expected_latency": {
      "default": "unknown",
      "title": "Expected Latency",
      "type": "string"
    },
    "freshness_score": {
      "description": "Declared prior until measured",
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Freshness Score",
      "type": "number"
    },
    "health_status": {
      "$ref": "#/$defs/HealthStatus",
      "default": "unknown"
    },
    "historical_coverage": {
      "default": "unknown",
      "title": "Historical Coverage",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "integrated_capabilities": {
      "items": {
        "type": "string"
      },
      "title": "Integrated Capabilities",
      "type": "array"
    },
    "integrated_via": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Source is an operational provider leg inside this parent collector.",
      "title": "Integrated Via"
    },
    "legal_use_status": {
      "$ref": "#/$defs/LegalUseStatus",
      "default": "review_required"
    },
    "license": {
      "default": "unknown",
      "title": "License",
      "type": "string"
    },
    "lifecycle_state": {
      "$ref": "#/$defs/LifecycleState",
      "default": "candidate"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "normalization_rules": {
      "items": {
        "type": "string"
      },
      "title": "Normalization Rules",
      "type": "array"
    },
    "notes": {
      "default": "",
      "title": "Notes",
      "type": "string"
    },
    "priority": {
      "default": 50,
      "description": "Collection scheduling priority (0-100, higher collected/discovered first). Distinct from conflict_priority, which only matters at resolution time.",
      "title": "Priority",
      "type": "integer"
    },
    "provenance_policy": {
      "default": "raw_document_envelope",
      "title": "Provenance Policy",
      "type": "string"
    },
    "rate_limit": {
      "$ref": "#/$defs/RateLimit"
    },
    "reliability_score": {
      "description": "Declared prior until measured",
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Reliability Score",
      "type": "number"
    },
    "reputation_score": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Composite score from sources.reputation; measured only, never declared.",
      "title": "Reputation Score"
    },
    "retry_policy": {
      "$ref": "#/$defs/RetryPolicy"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/SourceStatus"
    },
    "supported_entities": {
      "items": {
        "type": "string"
      },
      "title": "Supported Entities",
      "type": "array"
    },
    "supported_event_types": {
      "items": {
        "type": "string"
      },
      "title": "Supported Event Types",
      "type": "array"
    },
    "supported_languages": {
      "items": {
        "type": "string"
      },
      "title": "Supported Languages",
      "type": "array"
    },
    "terms_of_use_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Terms Of Use Url"
    },
    "update_frequency": {
      "default": "unknown",
      "title": "Update Frequency",
      "type": "string"
    },
    "validation_rules": {
      "items": {
        "type": "string"
      },
      "title": "Validation Rules",
      "type": "array"
    },
    "version": {
      "default": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "name",
    "category",
    "access_method",
    "status",
    "reliability_score",
    "freshness_score"
  ],
  "title": "SourceSpec",
  "type": "object"
}
